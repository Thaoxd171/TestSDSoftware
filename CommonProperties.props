<Project>
	<PropertyGroup>
		<Configurations>Revit_2024;Revit_2025</Configurations>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>false</UseWindowsForms>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>
		<LangVersion>10.0</LangVersion>
		<!-- Revit is 64-bit only; x64 also silences the MSB3270 architecture mismatch warning -->
		<PlatformTarget>x64</PlatformTarget>
		<!-- Revit ships many assemblies that resolve to different versions of the same BCL facades.
		     They are never copied to the output (Private=False), so demote the noise to messages. -->
		<MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
		<Authors>SD Software</Authors>
		<ErrorReport>prompt</ErrorReport>
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<WarningLevel>4</WarningLevel>
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
		<SignAssembly>false</SignAssembly>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<!-- Revit version / target framework driven by the selected Configuration -->
	<Choose>
		<When Condition="'$(Configuration)' == 'Revit_2024'">
			<PropertyGroup>
				<RevitVersion>2024</RevitVersion>
				<DefineConstants>TRACE;DEBUG;Revit_2024</DefineConstants>
				<TargetFramework>net48</TargetFramework>
			</PropertyGroup>
		</When>
		<When Condition="'$(Configuration)' == 'Revit_2025'">
			<PropertyGroup>
				<RevitVersion>2025</RevitVersion>
				<DefineConstants>TRACE;DEBUG;Revit_2025</DefineConstants>
				<TargetFramework>net8.0-windows</TargetFramework>
				<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
				<SelfContained>false</SelfContained>
			</PropertyGroup>
		</When>
		<Otherwise>
			<!-- Fallback so the project still evaluates when no Configuration is passed -->
			<PropertyGroup>
				<RevitVersion>2025</RevitVersion>
				<DefineConstants>TRACE;DEBUG;Revit_2025</DefineConstants>
				<TargetFramework>net8.0-windows</TargetFramework>
			</PropertyGroup>
		</Otherwise>
	</Choose>
</Project>
