<Window x:Class="SDSoftware.RevitTest.Features.AdjustBeam.Views.AdjustBeamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust structural beam"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="12"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SDRevitTest;component/Mvvm/Themes/SDStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="FieldLabel" TargetType="TextBlock">
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Margin" Value="0,0,12,0" />
			</Style>
			<Style x:Key="FieldBox" TargetType="TextBox">
				<Setter Property="Height" Value="26" />
				<Setter Property="Padding" Value="4,0" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="Margin" Value="0,0,0,8" />
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,14">
			<TextBlock Text="Adjust structural beams" FontSize="17" FontWeight="Bold" />
			<TextBlock Text="{Binding Hint}" Margin="0,3,0,0" TextWrapping="Wrap"
			           Foreground="{StaticResource MutedBrush}" />
		</StackPanel>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="140" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
			           Text="Beam &#8594; Wall clearance (mm)" />
			<TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"
			         Text="{Binding WallClearance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

			<TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
			           Text="Beam &#8594; Pillar clearance (mm)" />
			<TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}"
			         Text="{Binding PillarClearance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

			<TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
			           Text="Beam &#8594; Beam inline gap (mm)" />
			<TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}"
			         Text="{Binding InlineGap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

			<TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
			           Text="Beam &#8594; Beam perpendicular gap (mm)" />
			<TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldBox}"
			         Text="{Binding PerpendicularGap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />

			<TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"
			           Text="Beam corner at pillar" />
			<ComboBox Grid.Row="4" Grid.Column="1" Height="26" Margin="0,0,0,8"
			          VerticalContentAlignment="Center"
			          ItemsSource="{Binding CornerModes}"
			          SelectedItem="{Binding CornerMode}" />
		</Grid>

		<StackPanel Grid.Row="2" Margin="0,6,0,0">
			<CheckBox Content="Corner / T-shape at pillar: extend to beam body"
			          Margin="0,0,0,8"
			          IsChecked="{Binding ExtendToBeamBodyAtPillar}" />
			<CheckBox Content="Corner at wall: extend to beam body"
			          IsChecked="{Binding ExtendToBeamBodyAtWall}" />
		</StackPanel>

		<TextBlock Grid.Row="3"
		           Margin="0,12,0,0"
		           TextWrapping="Wrap"
		           Foreground="#FFC42B1C"
		           Text="{Binding ErrorMessage}" />

		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
			<Button Content="Adjust..." Width="110" Height="28" Margin="0,0,10,0"
			        IsDefault="True" IsEnabled="{Binding IsValid}" Click="OnAdjustClick" />
			<Button Content="Cancel" Width="110" Height="28" IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
