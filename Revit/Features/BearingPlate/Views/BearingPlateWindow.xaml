<Window x:Class="SDSoftware.RevitTest.Features.BearingPlate.Views.BearingPlateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Bearing Plate Drawings"
        Height="700"
        Width="700"
        MinHeight="420"
        MinWidth="520"
        FontFamily="Segoe UI"
        FontSize="12"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/SDRevitTest;component/Mvvm/Themes/SDStyles.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="14">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
			<TextBlock Text="Bearing Plate Drawings" FontSize="17" FontWeight="Bold" VerticalAlignment="Bottom" />
			<TextBlock Text="{Binding CheckedText}" FontSize="13" Margin="10,0,0,2"
			           VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
		</StackPanel>

		<TextBox Grid.Row="1"
		         Height="26"
		         Margin="0,0,0,10"
		         VerticalContentAlignment="Center"
		         Padding="4,0"
		         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

		<DataGrid Grid.Row="2"
		          ItemsSource="{Binding Plates}"
		          AutoGenerateColumns="False"
		          CanUserAddRows="False"
		          CanUserDeleteRows="False"
		          CanUserResizeRows="False"
		          HeadersVisibility="Column"
		          GridLinesVisibility="All"
		          SelectionMode="Extended"
		          RowHeight="24"
		          BorderBrush="{StaticResource BorderBrush}"
		          BorderThickness="1">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Family" Width="*" IsReadOnly="True" Binding="{Binding Family}" />
				<DataGridTextColumn Header="Type" Width="*" IsReadOnly="True" Binding="{Binding Type}" />
				<DataGridCheckBoxColumn Header="Has Assembly" Width="100" IsReadOnly="True"
				                        Binding="{Binding HasAssembly, Mode=OneWay}">
					<!-- Dimmed to signal this column is read-only (display only) -->
					<DataGridCheckBoxColumn.ElementStyle>
						<Style TargetType="CheckBox">
							<Setter Property="Opacity" Value="0.5" />
							<Setter Property="IsHitTestVisible" Value="False" />
							<Setter Property="HorizontalAlignment" Value="Center" />
						</Style>
					</DataGridCheckBoxColumn.ElementStyle>
				</DataGridCheckBoxColumn>
				<!-- Template column so the CheckBox lives in the cell (not edit mode): single click toggles -->
				<DataGridTemplateColumn Header="Select" Width="60">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
							          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
			<Button Content="Generate" Width="110" Height="28" Margin="0,0,10,0"
			        IsDefault="True" Click="OnGenerateClick" />
			<Button Content="Cancel" Width="110" Height="28" IsCancel="True" />
		</StackPanel>
	</Grid>
</Window>
